echo >&2
echo "'Remote' command runs remote-stage distro commands in current Remote context." >&2
echo "📘 syntax: Remote <distro-remote-command-name> [<arguments>...]" >&2
echo "📘 syntax: Remote --help" >&2
echo "📘 syntax: Remote --start-console [args...]" >&2
echo "📘 syntax: Remote --start-<subsystem>-tools-console [args...]" >&2
echo "📘 syntax: Remote --completion-<mode>" >&2
echo "📘 syntax: Remote --shell-prompt" >&2
echo >&2
echo "	Options:" >&2
echo "		--help  Print this help text." >&2
echo "		--help-syntax  Alias for --help." >&2
echo "		--start-console  Start remote interactive tools console." >&2
echo "		--start-remote-tools-console  Alias for --start-console." >&2
echo "		--start-local-tools-console  Start local tools console from remote context." >&2
echo "		--start-<subsystem>-tools-console  Start another installed subsystem console." >&2
echo "		--completion-<mode>  Completion dispatcher entry points used by shell completion." >&2
echo "		--shell-prompt  Print prompt template for interactive console rendering." >&2
echo >&2
echo "	Info:" >&2
echo "		MMDAPP ROOT: $MMDAPP" >&2
echo "		MDLT_ORIGIN: ${MDLT_ORIGIN:-"Not Set"}" >&2
echo "		MDSC_INMODE: ${MDSC_INMODE:-"Not Set"}" >&2
echo "		MDSC_OPTION: ${MDSC_OPTION:-"Not Set"}" >&2
echo >&2

set +e ; return 1
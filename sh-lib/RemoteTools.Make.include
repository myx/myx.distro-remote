#!/usr/bin/env bash
# ^^^ for syntax checking in the editor only

case "$1" in
	--make-workspace-integrations)
		shift

		if [ -z "$MDLT_ORIGIN" ] || [ "$MDLT_ORIGIN" = "$MMDAPP/.local" ] ; then
			mkdir -p "$MMDAPP/.local/remote"
		fi

		DistroRemoteTools --make-console-command "$@"
		return 0
	;;
	--make-console-command)
		shift
		set -e
		# shortcut for: `DistroRemoteTools --make-console-script`
		. "$MDLT_ORIGIN/myx/myx.distro-remote/sh-lib/RemoteTools.Make.DistroRemoteConsoleShellScript.include" \
		> "$MMDAPP/DistroRemoteConsole.sh"
		chmod 770 "$MMDAPP/DistroRemoteConsole.sh"

		if [ "$1" != "--quiet" ] ; then
			local consoles="$( ls $MMDAPP/Distro*Console.sh | sed 's|^|	|g' )"
			printf \
				"\nNote: DistroRemoteConsole.sh created, now you can run:\n%s\n\n" \
				"$consoles" \
			>&2
		fi

		return 0
	;;
	--make-console-script)
		shift

		. "$MDLT_ORIGIN/myx/myx.distro-remote/sh-lib/RemoteTools.Make.DistroRemoteConsoleShellScript.include"

		return 0
	;;
	*)
		echo "$MDSC_CMD: ⛔ ERROR: invalid option: $1" >&2
		set +e ; return 1
	;;
esac
